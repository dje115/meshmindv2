# MeshMind v2 - Environment Configuration
# Copy to .env in repo root.
# See docs/CONFIGURATION_AUDIT.md for full reference.
#
# Setting categories:
#   [BOOTSTRAP]  - Infrastructure/dev setup only; not UI-managed
#   [SECRET]     - Must not be committed; use env or secrets manager
#   [PLANNED-UI] - Will move to Settings UI / database in future

# --- Control API ---
CONTROL_API_PORT=3000

# --- Database & Cache (SECRET in production) ---
DATABASE_URL=postgres://meshmind:meshmind@localhost:5432/meshmind
REDIS_URL=redis://localhost:6379

# --- Auth (SECRET: required in production) ---
# Change in production. Insecure default is used only when unset.
JWT_SECRET=change-me-in-production

# --- Bootstrap: Dev Admin (BOOTSTRAP) ---
# Set to "true" to create admin user (admin/admin) on first run. Dev only.
# MESHMIND_SEED_DEV_ADMIN=false

# --- Query API (used by control-api for search/ask) ---
QUERY_API_URL=http://localhost:3001

# --- Search & Embeddings (PLANNED-UI; not yet wired) ---
QDRANT_URL=http://localhost:6333
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=dev-key-minimum-32-characters-long

# --- Ollama (PLANNED-UI; control-api config only, not yet used) ---
OLLAMA_URL=http://localhost:11434

# --- Workers: Control Plane (BOOTSTRAP) ---
CONTROL_API_URL=http://localhost:3000
MESHMIND_AGENT_NAME=meshmind-worker
MESHMIND_AGENT_CAPABILITIES=filesystem,docproc
# MESHMIND_AGENT_ID=          # Optional: pre-registered agent
# MESHMIND_HEARTBEAT_INTERVAL_SECS=30
# MESHMIND_CLAIM_INTERVAL_SECS=5

# --- Workers: Filesystem Connector (BOOTSTRAP) ---
# MESHMIND_CHANGE_STORE=data/connector-state

# --- Document Processing: Apache Tika (PLANNED-UI for endpoint) ---
# Required for .doc and some .xls extraction.
TIKA_SERVER_ENDPOINT=http://localhost:9998
# TIKA_TIMEOUT_SECS=60

# --- Optional: Config File Path (BOOTSTRAP) ---
# MESHMIND_CONFIG=meshmind.toml
