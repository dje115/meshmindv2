# MeshMind v2 - Infrastructure / Docker Compose
# Copy to .env in repo root or infrastructure/
# See root .env.example for full variable reference and categories.

# --- Control API ---
CONTROL_API_PORT=3000

# --- Postgres ---
DATABASE_URL=postgres://meshmind:meshmind@localhost:5432/meshmind

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth (SECRET: required in production) ---
JWT_SECRET=change-me-in-production

# --- Bootstrap: Dev Admin (BOOTSTRAP) ---
# MESHMIND_SEED_DEV_ADMIN=true

# --- Search (not yet wired) ---
QDRANT_URL=http://localhost:6333
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=dev-key-minimum-32-characters-long

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
