# MeshMind v2 - Infrastructure / Control API
# Copy to .env in repo root or infrastructure/

# --- Control API ---
CONTROL_API_PORT=3000

# --- Postgres ---
DATABASE_URL=postgres://meshmind:meshmind@localhost:5432/meshmind

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- Meilisearch ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=dev-key-minimum-32-characters-long

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
